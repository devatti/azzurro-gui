# ---------------------------------------------------------------------------
# Azzurro Dashboard configuration
# Copy this file to `.env` and fill in your ZCS Azzurro credentials.
# ---------------------------------------------------------------------------

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Rome

# Path to the SQLite database file (defaults to ./db.sqlite3)
# DJANGO_DB_PATH=/data/db.sqlite3

# ZCS Azzurro API
# ZCS_URL: portal endpoint used by the ZCS Azzurro devices
ZCS_URL=https://third.zcsazzurroportal.com:19003/

# Force mock/demo mode even if credentials are present:
# ZCS_USE_MOCK=true

# Realtime poll cache (seconds)
ZCS_REALTIME_CACHE_TTL=30

# Maximum span of a single historic request (the portal allows max 24h)
ZCS_MAX_HISTORY_SPAN=24

# How far back the history page can look (days)
ZCS_MAX_HISTORY_DAYS=7

# Weather (Open-Meteo, optional — the city is set on the Settings page)
# WEATHER_API_URL=https://api.open-meteo.com/v1
# WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1
# Weather snapshot cache (seconds)
WEATHER_CACHE_TTL=1800
# Forecast days shown in the widget
WEATHER_FORECAST_DAYS=5
